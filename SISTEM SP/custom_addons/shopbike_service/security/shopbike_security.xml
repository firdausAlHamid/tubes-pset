<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_shopbike_mechanic" model="res.groups">
        <field name="name">Shop &amp; Bike / Mekanik</field>
    </record>

    <record id="group_shopbike_cashier" model="res.groups">
        <field name="name">Shop &amp; Bike / Kasir (Service Advisor)</field>
    </record>

    <record id="group_shopbike_manager" model="res.groups">
        <field name="name">Shop &amp; Bike / Kepala Toko (Manager)</field>
        <field name="implied_ids" eval="[(4, ref('group_shopbike_cashier'))]"/>
    </record>

    <!-- Beri akses otomatis ke Administrator (base.group_system) agar menu langsung muncul -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_shopbike_manager'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_mechanic_own_orders" model="ir.rule">
        <field name="name">Mekanik: Hanya Lihat Service Order Milik Sendiri</field>
        <field name="model_id" ref="model_shopbike_service_order"/>
        <field name="domain_force">[('mechanic_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_shopbike_mechanic'))]"/>
    </record>

    <record id="rule_cashier_manager_all_orders" model="ir.rule">
        <field name="name">Kasir &amp; Kepala Toko: Lihat Semua Service Order</field>
        <field name="model_id" ref="model_shopbike_service_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_shopbike_cashier')), (4, ref('group_shopbike_manager'))]"/>
    </record>
</odoo>
