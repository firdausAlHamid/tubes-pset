<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopbike_vehicle_list" model="ir.ui.view">
        <field name="name">shopbike.vehicle.list</field>
        <field name="model">shopbike.vehicle</field>
        <field name="arch" type="xml">
            <list string="Daftar Kendaraan">
                <field name="license_plate"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="manufacture_year"/>
                <field name="last_odometer"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="view_shopbike_vehicle_form" model="ir.ui.view">
        <field name="name">shopbike.vehicle.form</field>
        <field name="model">shopbike.vehicle</field>
        <field name="arch" type="xml">
            <form string="Kendaraan Pelanggan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="license_plate" placeholder="D 4521 ZAB"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="brand" placeholder="Honda / Yamaha"/>
                            <field name="model_name" placeholder="Vario 160 / NMAX"/>
                        </group>
                        <group>
                            <field name="manufacture_year"/>
                            <field name="last_odometer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Riwayat Servis">
                            <field name="service_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="mechanic_id"/>
                                    <field name="amount_total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopbike_vehicle" model="ir.actions.act_window">
        <field name="name">Kendaraan Pelanggan</field>
        <field name="res_model">shopbike.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
